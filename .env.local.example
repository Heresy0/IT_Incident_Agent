# Copy to .env.local and supply your own API keys.
DASHSCOPE_API_KEY=
BOCHA_API_KEY=
MODEL=qwen-turbo
# Optional: for explicit incident live CLI only. Supply this project's local bearer token.
# INCIDENT_BEARER_TOKEN=
HOST=127.0.0.1
PORT=8003
APP_ENV=production
DEEP_RESEARCH_API_TARGET=http://127.0.0.1:8003
ENABLE_MEMORY=true
MAX_ITERATIONS=1
RESEARCH_MAX_CONCURRENCY=2
RESEARCH_MAX_MODEL_CALLS=16
RESEARCH_MAX_WEB_CALLS=12
RESEARCH_MAX_TOOL_CALLS=24
RESEARCH_MAX_SECONDS=180
SHORT_TERM_BACKEND=postgres
LONG_TERM_BACKEND=postgres
CHECKPOINTER_BACKEND=postgres
POSTGRES_DSN=postgresql://deepresearch:deepresearch_local@127.0.0.1:5434/deepresearch
REDIS_URL=redis://127.0.0.1:6380
ENABLE_MILVUS=true
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19531
MILVUS_COLLECTION=it_incident_memory_local
KNOWLEDGE_COLLECTION=it_incident_knowledge_local
# Only set this to a collection reviewed as public. Unclassified legacy collections are not shared.
RESEARCH_PUBLIC_KNOWLEDGE_COLLECTION=
# Defaults to .auth.local.json at the repository root; generate with scripts/setup_demo_auth.py.
# RESEARCH_AUTH_FILE=
SHORT_TERM_TTL_SECONDS=604800
SHORT_TERM_MAX_MESSAGES=30
SHORT_TERM_SUMMARY_THRESHOLD=20
SAVE_CONVERSATION_TASK=false
