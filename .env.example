# Supply this project's own model key only when explicitly running live diagnosis.
DASHSCOPE_API_KEY=
MODEL=qwen3.7-plus
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_API_KEY overrides DASHSCOPE_API_KEY when switching providers.
# MODEL_API_KEY=
# Provider-specific options; use {} for providers without enable_thinking.
MODEL_EXTRA_BODY={"enable_thinking":false}
# For explicit live CLI: a token registered in this project's .auth.local.json.
# INCIDENT_BEARER_TOKEN=
# INCIDENT_AUTH_FILE=
HOST=127.0.0.1
PORT=8003
APP_ENV=production
INCIDENT_MAX_CONCURRENCY=2
INCIDENT_MAX_MODEL_CALLS=32
INCIDENT_MAX_TOOL_CALLS=48
INCIDENT_MAX_SECONDS=300
# Maximum characters per complete model request (not tokens); range 4000-128000.
INCIDENT_MAX_INPUT_CHARS=48000
# INCIDENT_LOG_DIR=logs
# Optional server-owned service and repair bindings; default is empty/disabled.
# INCIDENT_SERVICES_FILE=D:/code/it_incident_agent/services.local.json
POSTGRES_DSN=postgresql://deepresearch:deepresearch_local@127.0.0.1:5434/deepresearch
# Optional dev proxy override; omitted means use PORT above.
# INCIDENT_API_TARGET=http://127.0.0.1:8003
